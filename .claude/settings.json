{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/LOQ/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/LOQ/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" || exit 0; S=graphify-out/.graph-stamp; [ -f graphify-out/graph.json ] || exit 0; if [ ! -f \"$S\" ] || [ -n \"$(find . -name \"*.py\" -newer \"$S\" -not -path \"./graphify-out/*\" -print -quit)\" ]; then C:/Users/LOQ/.local/bin/graphify.EXE update . >/dev/null 2>&1; touch \"$S\"; fi; exit 0",
            "async": true,
            "timeout": 300,
            "statusMessage": "Updating graphify knowledge graph..."
          }
        ]
      }
    ]
  }
}